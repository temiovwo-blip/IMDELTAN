# Public URL of the new Supabase project for this environment.
PUBLIC_SUPABASE_URL=
# Public publishable key for the new Supabase project; not a privileged key.
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public customer application origin, used for allowed redirects.
PUBLIC_CUSTOMER_ORIGIN=
# Public administrator application origin, used for allowed redirects.
PUBLIC_ADMIN_ORIGIN=
# Public CAPTCHA site key; the corresponding secret is server-side only.
PUBLIC_CAPTCHA_SITE_KEY=
# Deployment environment identifier: development, preview, staging, or production.
APP_ENVIRONMENT=
# Server-side only: Supabase URL for the isolated environment.
SUPABASE_URL=
# Server-side only: privileged Supabase key, supplied through provider secrets; never expose to clients.
SUPABASE_SERVICE_ROLE_KEY=
# Server-side only: CAPTCHA verification secret, supplied through provider secrets.
CAPTCHA_SECRET_KEY=
# Server-side only: transactional email provider credential.
EMAIL_PROVIDER_API_KEY=
# Server-side only: SMS provider credential.
SMS_PROVIDER_API_KEY=
# Server-side only: monitoring provider ingestion credential, if needed.
MONITORING_API_KEY=
# Customer web build: public URL of the new environment's Supabase project.
VITE_SUPABASE_URL=
# Customer web build: public publishable key for the same new project.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional local Vite dev-server only: opt in to unfinished social drafts. Never enable for real users.
VITE_ENABLE_SOCIAL_DRAFTS=
